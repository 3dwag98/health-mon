# Host port mappings. Copy to .env and change any that collide.
#
# Windows note: Hyper-V / WSL2 reserves blocks of high ports (check with
#   netsh interface ipv4 show excludedportrange protocol=tcp
# in an elevated prompt). Every default below is under 49152 to stay clear of
# the ephemeral range, but a reservation can still land on one -- if `up` fails
# with "bind: An attempt was made to access a socket in a way forbidden by its
# access permissions", change the number here rather than fighting Windows.
#
# Nothing in the stack needs these to talk to each other; they exist so you can
# reach the services from the host. The dependency ports can be commented out
# in docker-compose.yml entirely if you never poke at them directly.

# --- dependencies (host access only; the stack uses the compose network) ---
PG_HOST_PORT=15432
MQ_HOST_PORT=15673
MQ_MGMT_PORT=15672
RD_HOST_PORT=16379

# --- fault injection ---
TOXIPROXY_PORT=8474

# --- workers ---
BILLING_PORT=8081
NOTIFY_PORT=8082
RECONCILE_PORT=8083
LOADGEN_PORT=8090

# --- the dashboard you actually open ---
DASHBOARD_PORT=9000

# OTLP collector the workers push telemetry to.
OTEL_HTTP_PORT=4318
OTEL_METRICS_PORT=8888
